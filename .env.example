# Gemini (Google AI Studio free tier; never commit the real value)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Meta Instagram Graph API. The Instagram account must be professional.
INSTAGRAM_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0

# Required only for real publishing. A public GitHub repository is the
# included zero-cost image host. GITHUB_TOKEN is provided automatically in Actions.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/public-repository
GITHUB_BRANCH=main

# Optional failure notification webhook (for example, a private Discord webhook).
FAILURE_WEBHOOK_URL=

# dry-run, approval, or automatic. Keep dry-run until the readiness command passes.
RUN_MODE=dry-run
MOCK_GENERATION=false
MOCK_PUBLISH=false
